  "purpose": "Track many email accounts as approved roles without storing secrets or assuming cross-account identity.",
  "rules": {
    "verifyProfileBeforeEveryRun": true,
    "storeSecrets": false,
    "storePasswords": false,
    "storeMfaCodes": false,
    "storeCookies": false,
    "storeOauthTokens": false,
    "sendRequiresImmediateApproval": true,
    "deleteRequiresImmediateApproval": true,
    "archiveRequiresApprovalUnlessRuleApproved": true,
    "bulkActionsRequireApproval": true,
    "noCrossMailboxActionsWithoutExplicitRoleMatch": true
  },
