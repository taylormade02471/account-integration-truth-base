        "me.com",
        "mac.com"
      ],
      "status": "needs_supported_connector_or_safe_route",
      "safeRoutes": [
        "use a supported iCloud Mail connector if one becomes available",
        "forward or copy selected iCloud mail into an approved Gmail or Outlook mailbox",
        "use user-provided exports or supervised browser review"
      ],
      "note": "Do not store Apple ID passwords, app-specific passwords, MFA codes, iCloud session cookies, or recovery keys."
    }
  },
