        "live.com",
        "msn.com",
        "microsoft_365"
      ],
      "status": "declared",
      "note": "Hotmail uses the Outlook Email connector; do not create a separate fake Hotmail connector."
    },
    "icloud": {
      "connector": null,
      "accountTypes": [
